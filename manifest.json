{
  "manifest_version": 3,
  "name": "itzTikTok Optimizer",
  "version": "1.0.5",
  "description": "High-performance TikTok web optimization extension: reduces UI lag, virtualizes messaging and feeds, suppresses LIVE/dramas, and lowers resource usage.",
  "author": "itzCrih (https://itzcrih.it)",
  "homepage_url": "https://itzcrih.it",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "itzTikTok Optimizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content/page-interceptor.bundle.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content/content.bundle.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*"
  ]
}
